#!/usr/bin/env bash
# nord-exit: select the Nord+Tailscale exit node and keep the path healthy.
# Works as a stack host (Docker) and as a client (Mac or Ubuntu).
set -euo pipefail

OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
CONNECT_DEFAULT="Barcelona"

_SRC="${BASH_SOURCE[0]}"
while [[ -L "$_SRC" ]]; do
  _LINK="$(readlink "$_SRC")"
  if [[ "$_LINK" == /* ]]; then _SRC="$_LINK"; else _SRC="$(cd "$(dirname "$_SRC")" && pwd)/$_LINK"; fi
done
SCRIPT_DIR="$(cd "$(dirname "$_SRC")" && pwd)"
if [[ -f "$SCRIPT_DIR/docker-compose.yml" ]]; then
  STACK_DIR="$SCRIPT_DIR"
elif [[ -f "$SCRIPT_DIR/../docker-compose.yml" ]]; then
  STACK_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
else
  echo "nord-exit: cannot find docker-compose.yml next to or above $SCRIPT_DIR" >&2
  exit 1
fi
unset _SRC _LINK

env_get() {
  local key="$1"
  [[ -f "$STACK_DIR/.env" ]] || return 0
  grep -E "^${key}=" "$STACK_DIR/.env" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'" | tr -d '[:space:]'
}

if [[ -n "$(env_get CONNECT)" ]]; then
  CONNECT_DEFAULT="$(env_get CONNECT)"
fi
CONNECT_DEFAULT="${CONNECT_DEFAULT:-Barcelona}"
TS_HOSTNAME="$(env_get TS_HOSTNAME)"
TS_HOSTNAME="${TS_HOSTNAME:-nord-exit}"

if [[ -n "${TAILSCALE_CLI:-}" ]]; then
  TS="$TAILSCALE_CLI"
elif [[ "$OS" == darwin && -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]]; then
  TS="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
else
  TS="$(command -v tailscale 2>/dev/null || true)"
fi
[[ -n "$TS" ]] || TS="tailscale"

usage() {
  echo "Usage: $0 {on|off|status|ip|fix [--exit]|guard|doctor|watch-install|watch-uninstall}" >&2
  echo "  on               - ${CONNECT_DEFAULT} via nord-exit (public DNS; auto-rollback if broken)" >&2
  echo "  off              - clear exit; keep mesh (safe)" >&2
  echo "  fix              - unblackhole; re-enables if desired=on" >&2
  echo "  fix --exit       - unblackhole, then safely re-enable exit" >&2
  echo "  guard            - if exit dead / internet dead, recover (does not drop desired=on)" >&2
  echo "  watch-install    - install supervisor (LaunchAgent on macOS, systemd timer on Linux)" >&2
  echo "  watch-uninstall  - remove that supervisor" >&2
  exit 1
}

[[ $# -ge 1 ]] || usage
log() { printf '[nord-exit] %s\n' "$*" >&2; }

with_timeout() {
  local secs="$1"; shift
  "$@" &
  local pid=$!
  local i=0
  while kill -0 "$pid" 2>/dev/null; do
    if (( i >= secs )); then
      kill -9 "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      return 124
    fi
    sleep 1
    i=$((i + 1))
  done
  wait "$pid"
}

ts_ok() { with_timeout 3 "$TS" status >/dev/null 2>&1; }
ts_run() { local secs="$1"; shift; with_timeout "$secs" "$TS" "$@"; }
ts_json() { with_timeout 5 "$TS" status --json 2>/dev/null; }

GUARD_COOLDOWN_FILE="${TMPDIR:-/tmp}/nord-exit-guard-cooldown"
GUARD_FAIL_FILE="${TMPDIR:-/tmp}/nord-exit-guard-fails"
DESIRED_FILE="$STACK_DIR/state/desired-exit" # "on" | "off"

set_desired() {
  mkdir -p "$STACK_DIR/state"
  printf '%s\n' "$1" >"$DESIRED_FILE"
}

get_desired() {
  [[ -f "$DESIRED_FILE" ]] || { echo off; return; }
  tr -d '[:space:]' <"$DESIRED_FILE"
}

# host = this machine runs the Docker stack.
# client = only select the remote exit node.
# auto = host if the local vpn container is already running.
hosting_stack() {
  local role
  role="$(env_get NORD_EXIT_ROLE)"
  role="${role:-auto}"
  case "$role" in
    host) return 0 ;;
    client) return 1 ;;
    *)
      docker inspect -f '{{.State.Running}}' nord-exit-vpn 2>/dev/null | grep -qi true
      ;;
  esac
}

local_stack_running() {
  docker inspect -f '{{.State.Running}}' nord-exit-vpn 2>/dev/null | grep -qi true
}

flush_dns() {
  if [[ "$OS" == darwin ]]; then
    dscacheutil -flushcache 2>/dev/null || true
    killall -HUP mDNSResponder 2>/dev/null || true
  else
    resolvectl flush-caches 2>/dev/null || true
    systemd-resolve --flush-caches 2>/dev/null || true
  fi
}

linux_phys_if() {
  ip -4 route show default 2>/dev/null | awk '{for (i=1;i<NF;i++) if ($i=="dev") {print $(i+1); exit}}'
}

linux_ts_if() {
  ip -o link show 2>/dev/null | awk -F': ' '/tailscale/{print $2; exit}' | cut -d@ -f1
}

pin_exit_dns() {
  if [[ "$OS" == darwin ]]; then
    networksetup -setdnsservers Wi-Fi 1.1.1.1 8.8.8.8 2>/dev/null || true
    networksetup -setdnsservers Tailscale Empty 2>/dev/null || true
  else
    local phys tsif
    phys="$(linux_phys_if)"
    tsif="$(linux_ts_if)"
    [[ -n "$phys" ]] && resolvectl dns "$phys" 1.1.1.1 8.8.8.8 2>/dev/null || true
    [[ -n "$tsif" ]] && resolvectl dns "$tsif" 1.1.1.1 8.8.8.8 2>/dev/null || true
    [[ -n "$tsif" ]] && resolvectl domain "$tsif" "~." 2>/dev/null || true
  fi
  flush_dns
}

restore_dhcp_dns() {
  if [[ "$OS" == darwin ]]; then
    networksetup -setdnsservers Wi-Fi Empty 2>/dev/null || true
  else
    local phys tsif
    phys="$(linux_phys_if)"
    tsif="$(linux_ts_if)"
    [[ -n "$phys" ]] && resolvectl revert "$phys" 2>/dev/null || true
    [[ -n "$tsif" ]] && resolvectl revert "$tsif" 2>/dev/null || true
  fi
  flush_dns
}

mark_guard_cooldown() {
  local secs="${1:-120}"
  local until=$(( $(date +%s) + secs ))
  echo "$until" >"$GUARD_COOLDOWN_FILE"
}

guard_in_cooldown() {
  [[ -f "$GUARD_COOLDOWN_FILE" ]] || return 1
  local until now
  until=$(cat "$GUARD_COOLDOWN_FILE" 2>/dev/null || echo 0)
  now=$(date +%s)
  (( now < until ))
}

# Tailscale uses network_mode: service:vpn. Restarting vpn creates a new
# netns; a still-running tailscale stays in the old one (no eth0/nordlynx,
# wget country=?, Tailscale reports "network is down").
tailscale_shares_vpn_netns() {
  local vpn_ns ts_ns
  vpn_ns=$(docker exec nord-exit-vpn readlink /proc/1/ns/net 2>/dev/null || true)
  ts_ns=$(docker exec nord-exit-tailscale readlink /proc/1/ns/net 2>/dev/null || true)
  [[ -n "$vpn_ns" && "$vpn_ns" == "$ts_ns" ]]
}

ensure_tailscale_on_vpn_netns() {
  local_stack_running || return 1
  if tailscale_shares_vpn_netns; then
    return 0
  fi
  log "Tailscale netns detached from VPN (stale after vpn restart) — reattaching..."
  docker restart nord-exit-tailscale >/dev/null 2>&1 || return 1
  local i
  for i in $(seq 1 20); do
    if tailscale_shares_vpn_netns; then
      log "Tailscale reattached to VPN netns."
      ensure_container_udp_holes
      return 0
    fi
    sleep 1
  done
  log "Failed to reattach Tailscale to VPN netns."
  return 1
}

# Re-apply container firewall holes (Nord rewrites iptables on reconnect).
ensure_container_udp_holes() {
  local_stack_running || return 0
  docker exec nord-exit-vpn sh -c '
    iptables -C OUTPUT -o eth0 -p udp -j ACCEPT 2>/dev/null || iptables -I OUTPUT -o eth0 -p udp -j ACCEPT
    iptables -C OUTPUT -o eth0 -p icmp -j ACCEPT 2>/dev/null || iptables -I OUTPUT -o eth0 -p icmp -j ACCEPT
    iptables -C FORWARD -i tailscale0 -o nordlynx -j ACCEPT 2>/dev/null || iptables -I FORWARD -i tailscale0 -o nordlynx -j ACCEPT
    iptables -C FORWARD -i nordlynx -o tailscale0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
      || iptables -I FORWARD -i nordlynx -o tailscale0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
    iptables -t nat -C POSTROUTING -o nordlynx -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -o nordlynx -j MASQUERADE
    gw=$(ip -4 route show 100.64.0.0/10 2>/dev/null | awk "{for(i=1;i<NF;i++) if(\$i==\"via\"){print \$(i+1); exit}}")
    if [ -z "$gw" ]; then
      gw=$(ip -4 route show default 2>/dev/null | grep -v nordlynx | awk "{for(i=1;i<NF;i++) if(\$i==\"via\"){print \$(i+1); exit}}")
    fi
    endpoint=$(wg show nordlynx endpoints 2>/dev/null | awk "{print \$2}" | head -1 | cut -d: -f1)
    if [ -n "$gw" ] && [ -n "$endpoint" ]; then
      ip -4 route replace "$endpoint" via "$gw" dev eth0
    fi
    if [ -n "$gw" ]; then
      ip rule show | grep -q "fwmark 0xe1f1" || ip rule add fwmark 0xe1f1 lookup 51820
      ip -4 route replace default via "$gw" dev eth0 table 51820
      ip -4 route replace 100.64.0.0/10 via "$gw" dev eth0
    fi
    if ip link show nordlynx >/dev/null 2>&1 && ! ip -4 route show default | grep -q nordlynx; then
      ip -4 route replace default dev nordlynx
    fi
  ' >/dev/null 2>&1 || true
}

quit_tailscale_app() {
  if [[ "$OS" != darwin ]]; then
    return 0
  fi
  osascript -e 'quit app "Tailscale"' 2>/dev/null || true
  pkill -x Tailscale 2>/dev/null || true
  pkill -9 -f '/Applications/Tailscale.app/Contents/MacOS/Tailscale' 2>/dev/null || true
}

internet_ok() {
  curl -4 -fsS --max-time 4 https://1.1.1.1 -o /dev/null 2>/dev/null \
    || { if [[ "$OS" == darwin ]]; then ping -c 1 -W 2000 1.1.1.1 >/dev/null 2>&1; else ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1; fi; } \
    || return 1
  if curl -4 -fsS --max-time 5 https://example.com -o /dev/null 2>/dev/null; then
    return 0
  fi
  local a
  a=$(resolve_a example.com)
  [[ -n "$a" ]] || a=$(dig +short example.com A 2>/dev/null | awk '/^[0-9.]+$/ {print; exit}')
  [[ -n "$a" ]] || return 1
  curl -4 -fsS --max-time 5 --resolve "example.com:443:$a" https://example.com -o /dev/null 2>/dev/null
}

# Resolve via public DNS only. LAN resolvers blackhole once the default
# route is the Tailscale tunnel and --exit-node-allow-lan-access=false.
resolve_a() {
  local host="$1" a
  a=$(dig @1.1.1.1 +time=2 +tries=1 +short "$host" A 2>/dev/null | awk '/^[0-9.]+$/ {print; exit}')
  [[ -n "$a" ]] || a=$(dig @8.8.8.8 +time=2 +tries=1 +short "$host" A 2>/dev/null | awk '/^[0-9.]+$/ {print; exit}')
  printf '%s' "$a"
}

default_route_dev() {
  if [[ "$OS" == darwin ]]; then
    route -n get 1.1.1.1 2>/dev/null | awk '/interface:/{print $2; exit}'
  else
    ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1;i<NF;i++) if ($i=="dev") {print $(i+1); exit}}'
  fi
}

on_exit_dataplane() {
  local dev
  dev="$(default_route_dev)"
  [[ "$dev" == utun* || "$dev" == tailscale* ]]
}

wait_exit_data_plane() {
  local i
  for i in $(seq 1 15); do
    if on_exit_dataplane; then
      if curl -4 -fsS --max-time 4 https://1.1.1.1 -o /dev/null 2>/dev/null \
        && [[ -n "$(resolve_a example.com)" ]]; then
        return 0
      fi
    fi
    sleep 1
  done
  log "Exit data plane not ready (dev=$(default_route_dev))."
  return 1
}

show_public_ip() {
  local i out a
  a=$(resolve_a ipinfo.io)
  for i in 1 2 3 4 5; do
    [[ -n "$a" ]] || a=$(resolve_a ipinfo.io)
    if [[ -n "$a" ]]; then
      if out=$(curl -4 -fsS --max-time 8 --resolve "ipinfo.io:443:$a" https://ipinfo.io/json 2>/dev/null); then
        printf '%s\n' "$out"
        return 0
      fi
    fi
    if out=$(curl -4 -fsS --max-time 8 https://ipinfo.io/json 2>/dev/null); then
      printf '%s\n' "$out"
      return 0
    fi
    sleep 1
  done
  log "Public IP check failed."
  return 1
}

wait_ts_ok() {
  local max="${1:-12}" i
  for i in $(seq 1 "$max"); do
    ts_ok && return 0
    sleep 1
  done
  return 1
}

kick_network_extension() {
  if [[ "$OS" != darwin ]]; then
    return 1
  fi
  if sudo -n true 2>/dev/null; then
    log "Kicking Tailscale network extension (passwordless sudo)..."
    sudo -n pkill -9 -f 'io.tailscale.ipn.macsys.network-extension' 2>/dev/null || true
    return 0
  fi
  log "Skipping network-extension kick (no passwordless sudo; will not prompt)."
  return 1
}

dismiss_stale_admin_prompts() {
  [[ "$OS" == darwin ]] || return 0
  pkill -f 'osascript.*io.tailscale.ipn.macsys.network-extension.*administrator privileges' 2>/dev/null || true
}

# Guaranteed goal: hostname internet works via ISP.
restore_isp() {
  log "Restoring ISP path..."

  if [[ "$OS" == darwin ]] && ! internet_ok; then
    log "Internet dead — quitting Tailscale immediately to drop MagicDNS..."
    quit_tailscale_app
    flush_dns
    sleep 2
    if internet_ok; then
      log "ISP OK (Tailscale quit)."
      return 0
    fi
  fi

  if ts_ok; then
    ts_run 5 set --exit-node= >/dev/null 2>&1 || true
    ts_run 5 set --accept-dns=false >/dev/null 2>&1 || true
    ts_run 12 up --reset --accept-dns=false --exit-node= --exit-node-allow-lan-access=false >/dev/null 2>&1 || true
    restore_dhcp_dns
    sleep 1
    if internet_ok; then
      log "ISP OK (cleared exit / LAN DNS)."
      return 0
    fi
  elif internet_ok; then
    log "ISP OK (CLI unresponsive; not quitting Tailscale / not prompting)."
    return 0
  fi

  if [[ "$OS" != darwin ]]; then
    log "WARNING: ISP still not healthy — check the uplink. Not stopping tailscaled."
    return 1
  fi

  log "Quitting Tailscale to drop MagicDNS blackhole..."
  quit_tailscale_app
  flush_dns
  sleep 2
  if internet_ok; then
    log "ISP OK (Tailscale quit)."
    return 0
  fi

  kick_network_extension || true
  quit_tailscale_app
  flush_dns
  sleep 2
  if internet_ok; then
    log "ISP OK after extension kick."
    return 0
  fi
  log "WARNING: ISP still not healthy — check Wi‑Fi."
  return 1
}

bring_up_tailscale() {
  log "Starting Tailscale backend..."
  if [[ "$OS" == darwin ]]; then
    open -a Tailscale
  fi
  if ! ts_run 15 up --reset --accept-dns=false --exit-node= --exit-node-allow-lan-access=false >/dev/null 2>&1; then
    log "tailscale up failed or timed out."
    if [[ "$OS" == darwin ]]; then
      kick_network_extension || true
    elif sudo -n true 2>/dev/null; then
      sudo -n systemctl start tailscaled 2>/dev/null || true
    fi
    if ! ts_run 15 up --reset --accept-dns=false --exit-node= --exit-node-allow-lan-access=false >/dev/null 2>&1; then
      log "tailscale up still failing."
      internet_ok && return 1
      if [[ "$OS" == darwin ]]; then
        quit_tailscale_app
        flush_dns
      fi
      return 1
    fi
  fi
  ts_run 5 set --exit-node= --accept-dns=false >/dev/null 2>&1 || true
  flush_dns
  if ts_ok && internet_ok; then
    return 0
  fi
  if ts_ok; then
    log "Tailscale backend is up but internet check failed."
    return 1
  fi
  log "CLI not healthy after up."
  return 1
}

ensure_docker() {
  if docker info >/dev/null 2>&1; then return 0; fi
  if [[ "$OS" == darwin ]]; then
    log "Starting Docker Desktop..."
    open -a Docker
  else
    log "Starting Docker engine..."
    sudo -n systemctl start docker 2>/dev/null || true
  fi
  local i
  for i in $(seq 1 60); do
    docker info >/dev/null 2>&1 && return 0
    sleep 2
  done
  return 1
}

# After the stack directory moved, leftover containers still owned by the
# old compose project block `docker compose up` with a name conflict.
reclaim_foreign_stack() {
  local have want
  have=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' nord-exit-vpn 2>/dev/null || true)
  want=$(cd "$STACK_DIR" && docker compose config --format json 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin).get("name",""))' 2>/dev/null || echo nord-exit)
  [[ -z "$have" ]] && return 0
  [[ "$have" == "$want" ]] && return 0
  log "Removing leftover containers from compose project '$have' (stack is now '$want')..."
  docker rm -f nord-exit-vpn nord-exit-tailscale >/dev/null 2>&1 || true
  docker network rm "${have}_default" >/dev/null 2>&1 || true
}

compose_up_stack() {
  reclaim_foreign_stack
  (cd "$STACK_DIR" && docker compose up -d)
}

heal_nord_stack() {
  if ! hosting_stack && ! local_stack_running; then
    log "Client-only — skipping local Docker heal."
    return 0
  fi
  log "Healing Nord exit Docker stack..."
  ensure_docker || { log "Docker unavailable."; return 1; }
  compose_up_stack || true

  local i h
  h=$(docker inspect -f '{{.State.Health.Status}}' nord-exit-vpn 2>/dev/null || echo missing)
  if [[ "$h" != "healthy" ]]; then
    log "vpn health=$h — restarting containers..."
    docker restart nord-exit-vpn >/dev/null 2>&1 || true
    sleep 3
    docker restart nord-exit-tailscale >/dev/null 2>&1 || true
  else
    log "vpn already healthy — skipping restart."
  fi

  for i in $(seq 1 40); do
    h=$(docker inspect -f '{{.State.Health.Status}}' nord-exit-vpn 2>/dev/null || echo starting)
    [[ "$h" == "healthy" ]] && break
    sleep 2
  done

  docker exec nord-exit-vpn nordvpn set firewall disabled >/dev/null 2>&1 || true
  docker exec nord-exit-vpn nordvpn set killswitch disabled >/dev/null 2>&1 || true
  docker exec nord-exit-vpn sh -c \
    "nordvpn status | grep -q 'Status: Connected' || nordvpn connect '${CONNECT_DEFAULT}'" \
    >/dev/null 2>&1 || true
  docker exec nord-exit-tailscale tailscale --socket=/tmp/tailscaled.sock \
    set --advertise-exit-node --accept-dns=false --hostname="$TS_HOSTNAME" \
    >/dev/null 2>&1 || true
  ensure_tailscale_on_vpn_netns || true
  ensure_container_udp_holes

  for i in $(seq 1 12); do
    if docker exec nord-exit-tailscale wget -qO- --timeout=8 https://ipinfo.io/country 2>/dev/null | grep -q .; then
      log "Nord container egress OK."
      return 0
    fi
    sleep 2
  done
  log "WARNING: Nord container egress check failed."
  return 1
}

resolve_nord_peer() {
  ts_json | python3 -c '
import json,sys
d=json.load(sys.stdin)
live=[]
for p in d.get("Peer",{}).values():
    dns=(p.get("DNSName") or "").rstrip(".")
    host=(p.get("HostName") or "")
    if not p.get("ExitNodeOption"):
        continue
    if "nord-exit" not in dns and not host.startswith("nord-exit"):
        continue
    ips=p.get("TailscaleIPs") or []
    ip=ips[0] if ips else dns
    online=1 if p.get("Online") else 0
    live.append((0 if dns.startswith("nord-exit.") else 1, -online, dns, ip, p.get("ID") or "", online))
live.sort()
if not live:
    sys.exit(1)
_,_,dns,ip,pid,online=live[0]
print(f"{ip}\t{pid}\t{online}")
'
}

wait_peer_online() {
  local i peer
  for i in $(seq 1 20); do
    peer=$(resolve_nord_peer 2>/dev/null || true)
    if [[ -n "$peer" && "$(printf '%s' "$peer" | cut -f3)" == "1" ]]; then
      printf '%s\n' "$peer"
      return 0
    fi
    sleep 2
  done
  return 1
}

# Require Nord container itself to be in Spain before we risk host routing.
# Client-only machines skip this and rely on the post-enable IP check.
preflight_nord_barcelona() {
  if ! local_stack_running; then
    log "No local stack — skipping container preflight (client mode)."
    return 0
  fi
  local city country
  if ! ensure_tailscale_on_vpn_netns; then
    log "Tailscale is not on the VPN network namespace — refusing to enable exit."
    return 1
  fi
  if ! docker exec nord-exit-vpn nordvpn status 2>/dev/null | grep -q 'Status: Connected'; then
    log "Nord container not Connected — connecting ${CONNECT_DEFAULT}..."
    docker exec nord-exit-vpn nordvpn set firewall disabled >/dev/null 2>&1 || true
    docker exec nord-exit-vpn nordvpn set killswitch disabled >/dev/null 2>&1 || true
    docker exec nord-exit-vpn nordvpn connect "$CONNECT_DEFAULT" >/dev/null 2>&1 || true
    sleep 3
  fi
  city=$(docker exec nord-exit-vpn nordvpn status 2>/dev/null | awk -F': ' '/^City:/{print $2; exit}')
  country=$(docker exec nord-exit-tailscale wget -qO- --timeout=8 https://ipinfo.io/country 2>/dev/null | tr -d '\r\n' || true)
  log "Nord preflight: city=${city:-?} container_country=${country:-?}"
  if [[ -z "$country" ]]; then
    log "Could not read container egress country (DNS/netns) — refusing to enable exit."
    return 1
  fi
  if [[ "$country" != "ES" ]]; then
    log "Container egress is not Spain — refusing to enable exit (prevents blackhole/wrong geo)."
    return 1
  fi
  return 0
}

clear_exit_safe() {
  ts_run 6 set --exit-node= >/dev/null 2>&1 || true
  ts_run 6 set --accept-dns=false >/dev/null 2>&1 || true
  restore_dhcp_dns
  flush_dns
}

enable_exit() {
  local peer NODE json country i
  if ! ts_ok; then
    log "Tailscale CLI not responsive — cannot enable exit."
    return 1
  fi

  if ! preflight_nord_barcelona; then
    clear_exit_safe
    return 1
  fi

  peer=$(wait_peer_online) || {
    log "nord-exit peer not online — leaving exit cleared."
    clear_exit_safe
    return 1
  }
  NODE=$(printf '%s' "$peer" | cut -f1)

  ping_out=$(ts_run 8 ping -c 1 -timeout 5s "$NODE" 2>&1 || true)
  if ! printf '%s' "$ping_out" | grep -qi 'pong from'; then
    log "Cannot ping nord-exit — refusing to enable exit."
    log "$ping_out"
    clear_exit_safe
    return 1
  fi
  log "Reachable via: $(printf '%s' "$ping_out" | awk '/pong from/{print; exit}')"

  pin_exit_dns
  clear_exit_safe
  pin_exit_dns
  sleep 1
  if ! ts_run 10 set --exit-node="$NODE" --exit-node-allow-lan-access=false --accept-dns=false; then
    log "Failed to set exit node."
    clear_exit_safe
    return 1
  fi
  log "Exit node set to $NODE (public DNS via exit; LAN access off)."
  pin_exit_dns
  mark_guard_cooldown
  rm -f "$GUARD_FAIL_FILE"

  if ! wait_exit_data_plane; then
    log "Internet broke after exit — rolling back to ISP."
    clear_exit_safe
    return 1
  fi
  if ! internet_ok; then
    log "Internet broke after exit — rolling back to ISP."
    clear_exit_safe
    return 1
  fi

  json=$(show_public_ip 2>/dev/null || true)
  if [[ -z "$json" ]]; then
    log "Could not verify public IP — rolling back."
    clear_exit_safe
    return 1
  fi
  printf '%s\n' "$json"
  country=$(printf '%s' "$json" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("country",""))' 2>/dev/null || true)
  if [[ "$country" != "ES" ]]; then
    log "Expected Spain egress, got '${country:-?}' — rolling back."
    clear_exit_safe
    return 1
  fi

  sleep 3
  if ! internet_ok; then
    log "Internet flaked after verify — rolling back."
    clear_exit_safe
    return 1
  fi
  log "Barcelona exit verified and stable."
  return 0
}

prefs_has_exit_node() {
  with_timeout 4 "$TS" debug prefs 2>/dev/null | python3 -c '
import json,sys
d=json.load(sys.stdin)
sys.exit(0 if d.get("ExitNodeID") else 1)
' 2>/dev/null
}

selected_exit_peer_online() {
  ts_json | python3 -c '
import json,sys
d=json.load(sys.stdin)
ens=d.get("ExitNodeStatus") or {}
eid=ens.get("ID") if isinstance(ens, dict) else None
if not eid:
    for p in d.get("Peer",{}).values():
        if p.get("ExitNode"):
            eid=p.get("ID"); break
if not eid: sys.exit(2)
for p in d.get("Peer",{}).values():
    if p.get("ID")==eid: sys.exit(0 if p.get("Online") else 1)
sys.exit(1)
'
}

doctor() {
  log "=== doctor ==="
  log "os=$OS stack=$STACK_DIR role=$(env_get NORD_EXIT_ROLE) hosting=$(hosting_stack && echo yes || echo no)"
  if [[ "$OS" == darwin ]]; then
    route -n get default 2>&1 | sed -n '1,10p' >&2 || true
    scutil --dns 2>/dev/null | head -18 >&2 || true
  else
    ip -4 route show 2>&1 | head -15 >&2 || true
    resolvectl status 2>/dev/null | head -30 >&2 || true
  fi
  if ts_ok; then
    ts_run 5 status 2>&1 | head -10 >&2 || true
  else
    log "Tailscale CLI NOT responsive."
  fi
  docker ps --format '{{.Names}} {{.Status}}' 2>/dev/null | grep nord >&2 || log "No nord containers"
  if internet_ok; then log "internet_ok=yes"; else log "internet_ok=no"; fi
  show_public_ip || true
}

install_watch_darwin() {
  local plist="$HOME/Library/LaunchAgents/com.youwen.nord-exit-guard.plist"
  mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
  cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.youwen.nord-exit-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>${STACK_DIR}/bin/nord-exit</string>
    <string>guard</string>
  </array>
  <key>StartInterval</key><integer>45</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>${HOME}/Library/Logs/nord-exit-guard.log</string>
  <key>StandardErrorPath</key><string>${HOME}/Library/Logs/nord-exit-guard.log</string>
</dict>
</plist>
EOF
  launchctl bootout "gui/$(id -u)/com.youwen.nord-exit-guard" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
  launchctl enable "gui/$(id -u)/com.youwen.nord-exit-guard" 2>/dev/null || true
  log "Installed supervisor (every 45s). Log: ~/Library/Logs/nord-exit-guard.log"
}

uninstall_watch_darwin() {
  launchctl bootout "gui/$(id -u)/com.youwen.nord-exit-guard" 2>/dev/null || true
  rm -f "$HOME/Library/LaunchAgents/com.youwen.nord-exit-guard.plist"
  log "Watchdog removed."
}

install_watch_linux() {
  local unit_dir="$HOME/.config/systemd/user"
  mkdir -p "$unit_dir"
  if [[ -f "$STACK_DIR/deploy/nord-exit-guard.service" ]]; then
    sed "s|@STACK_DIR@|${STACK_DIR}|g; s|@HOME@|${HOME}|g" \
      "$STACK_DIR/deploy/nord-exit-guard.service" >"$unit_dir/nord-exit-guard.service"
    sed "s|@STACK_DIR@|${STACK_DIR}|g; s|@HOME@|${HOME}|g" \
      "$STACK_DIR/deploy/nord-exit-guard.timer" >"$unit_dir/nord-exit-guard.timer"
  else
    cat >"$unit_dir/nord-exit-guard.service" <<EOF
[Unit]
Description=nord-exit desired-state guard

[Service]
Type=oneshot
ExecStart=/bin/bash ${STACK_DIR}/bin/nord-exit guard
EOF
    cat >"$unit_dir/nord-exit-guard.timer" <<EOF
[Unit]
Description=Run nord-exit guard every 45s

[Timer]
OnBootSec=45
OnUnitActiveSec=45
AccuracySec=5s
Persistent=true

[Install]
WantedBy=timers.target
EOF
  fi
  systemctl --user daemon-reload
  systemctl --user enable --now nord-exit-guard.timer
  loginctl enable-linger "$(id -un)" 2>/dev/null || true
  log "Installed systemd user timer (every 45s): nord-exit-guard.timer"
}

uninstall_watch_linux() {
  systemctl --user disable --now nord-exit-guard.timer 2>/dev/null || true
  rm -f "$HOME/.config/systemd/user/nord-exit-guard.service" \
    "$HOME/.config/systemd/user/nord-exit-guard.timer"
  systemctl --user daemon-reload 2>/dev/null || true
  log "Watchdog removed."
}

case "$1" in
  on)
    set_desired on
    if hosting_stack || [[ "$(env_get NORD_EXIT_ROLE)" == "host" ]]; then
      ensure_docker || { log "Docker unavailable."; exit 1; }
      compose_up_stack >/dev/null
      for _ in $(seq 1 30); do
        h=$(docker inspect -f '{{.State.Health.Status}}' nord-exit-vpn 2>/dev/null || echo starting)
        [[ "$h" == "healthy" ]] && break
        sleep 2
      done
      ensure_tailscale_on_vpn_netns || { log "Could not attach Tailscale to VPN netns."; exit 1; }
      ensure_container_udp_holes
    else
      log "Client-only — will select the remote nord-exit peer."
    fi
    if ! ts_ok; then
      bring_up_tailscale || { log "Could not start Tailscale backend."; exit 1; }
    fi
    enable_exit || exit 1
    ;;
  off)
    set_desired off
    if ts_ok; then
      ts_run 8 up --reset --accept-dns=false --exit-node= --exit-node-allow-lan-access=false >/dev/null 2>&1 || true
      ts_run 5 set --exit-node= --accept-dns=false >/dev/null 2>&1 || true
    else
      restore_isp || true
      bring_up_tailscale || true
    fi
    restore_dhcp_dns
    log "Exit cleared (desired=off). Mesh should work; no location spoof."
    show_public_ip || true
    ;;
  guard)
    dismiss_stale_admin_prompts
    if guard_in_cooldown; then
      exit 0
    fi
    desired=$(get_desired)
    bump_fail() {
      local n=0
      [[ -f "$GUARD_FAIL_FILE" ]] && n=$(cat "$GUARD_FAIL_FILE" 2>/dev/null || echo 0)
      n=$((n + 1))
      echo "$n" >"$GUARD_FAIL_FILE"
      echo "$n"
    }
    clear_fails() { rm -f "$GUARD_FAIL_FILE"; }

    ensure_container_udp_holes

    if [[ "$desired" != "on" ]]; then
      if prefs_has_exit_node && ! internet_ok; then
        log "desired=off but exit stuck/dead — clearing."
        clear_exit_safe
      fi
      clear_fails
      exit 0
    fi

    ts_rc=0
    with_timeout 3 "$TS" status >/dev/null 2>&1 || ts_rc=$?
    if (( ts_rc == 124 )); then
      n=$(bump_fail)
      if internet_ok; then
        log "CLI hung (x$n) but internet OK — not quitting / not prompting for admin."
      else
        log "CLI hung (x$n) and internet dead — restoring ISP (no password prompt)."
        restore_isp || true
      fi
      if (( n >= 2 )); then
        log "CLI hung repeatedly — backing off 10 minutes."
        mark_guard_cooldown 600
        clear_fails
      fi
      exit 0
    fi
    if (( ts_rc != 0 )); then
      n=$(bump_fail)
      log "Tailscale not running (x$n) while desired=on — starting backend."
      if bring_up_tailscale; then
        clear_fails
      elif (( n >= 2 )); then
        log "Could not start Tailscale — backing off 10 minutes."
        mark_guard_cooldown 600
        clear_fails
      fi
      exit 0
    fi

    if prefs_has_exit_node; then
      set +e; selected_exit_peer_online; rc=$?; set -e
      if [[ $rc -ne 0 ]]; then
        n=$(bump_fail)
        log "Exit peer unhealthy (x$n) — recovering (not dropping desired=on)."
        if (( n >= 2 )); then
          clear_exit_safe
          ensure_container_udp_holes
          if local_stack_running; then
            docker restart nord-exit-tailscale >/dev/null 2>&1 || true
            sleep 4
          fi
          enable_exit >/dev/null 2>&1 || true
          mark_guard_cooldown
          clear_fails
        fi
        exit 0
      fi
      if ! internet_ok; then
        pin_exit_dns
        sleep 1
        if internet_ok; then
          clear_fails
          exit 0
        fi
        n=$(bump_fail)
        log "Internet dead on exit (x$n) — recover path."
        if (( n >= 2 )); then
          clear_exit_safe
          ensure_container_udp_holes
          if ! internet_ok; then
            restore_isp || true
            bring_up_tailscale || true
          fi
          enable_exit >/dev/null 2>&1 || true
          mark_guard_cooldown
          clear_fails
        fi
        exit 0
      fi
      clear_fails
      exit 0
    fi

    n=$(bump_fail)
    log "desired=on but exit not selected (x$n) — enabling."
    ensure_container_udp_holes
    enable_exit >/dev/null 2>&1 || true
    mark_guard_cooldown
    if prefs_has_exit_node && internet_ok; then
      clear_fails
    fi
    ;;
  watch-install)
    if [[ "$OS" == darwin ]]; then install_watch_darwin; else install_watch_linux; fi
    ;;
  watch-uninstall)
    if [[ "$OS" == darwin ]]; then uninstall_watch_darwin; else uninstall_watch_linux; fi
    ;;
  fix)
    FORCE_OFF=0
    WANT_EXIT=0
    if [[ "${2:-}" == "--exit" || "${2:-}" == "exit" ]]; then
      WANT_EXIT=1
      set_desired on
    elif [[ "${2:-}" == "--off" ]]; then
      FORCE_OFF=1
      set_desired off
    elif [[ "$(get_desired)" == "on" ]]; then
      WANT_EXIT=1
    fi
    if [[ $WANT_EXIT -eq 1 ]]; then
      log "=== fix: unblackhole then re-enable exit (desired=$(get_desired)) ==="
    else
      log "=== fix: unblackhole only (desired=$(get_desired)) ==="
    fi

    restore_isp || true
    if ! internet_ok; then
      log "ISP still down — check the uplink. Aborting."
      doctor
      exit 1
    fi
    log "ISP baseline:"
    show_public_ip || true

    heal_nord_stack || log "Nord heal had warnings; continuing..."
    ensure_container_udp_holes

    if ! bring_up_tailscale; then
      log "fix partial: ISP restored; host Tailscale CLI still hung."
      show_public_ip || true
      exit 0
    fi

    if [[ $WANT_EXIT -eq 1 && $FORCE_OFF -eq 0 ]]; then
      if enable_exit; then
        log "fix complete — exit re-enabled (desired=on)."
        exit 0
      fi
      log "Exit not re-enabled yet; supervisor will keep trying. ISP works."
    else
      log "fix complete — exit OFF."
    fi
    show_public_ip || true
    internet_ok
    ;;
  doctor) doctor ;;
  status)
    if ts_ok; then
      ts_run 6 status || true
      echo
      ts_run 6 exit-node list 2>/dev/null | head -20 || true
    else
      log "Tailscale CLI hung (try: nord-exit fix)."
    fi
    show_public_ip || true
    ;;
  ip) show_public_ip ;;
  *) usage ;;
esac

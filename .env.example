# NordVPN access token (Nord account → manual configuration). Never commit the real value.
TOKEN=
# Preferred Nord city/country (underscore form).
CONNECT=Barcelona
TECHNOLOGY=NordLynx
# Allow Tailscale CGNAT through Nord.
NETWORK=100.64.0.0/10
TZ=Asia/Hong_Kong

# Reusable, non-ephemeral Tailscale auth key (admin console → Settings → Keys).
# Required for unattended ./up.sh and deploy/bootstrap.sh.
TS_AUTHKEY=
TS_HOSTNAME=nord-exit
TS_EXTRA_ARGS=--advertise-exit-node --accept-dns=false

# host   = this machine runs the Docker stack
# client = only select the remote exit node (typical for a laptop after cutover)
# auto   = host if local nord-exit-vpn is already running
NORD_EXIT_ROLE=host
